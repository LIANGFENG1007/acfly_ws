        <visual name="grid_v_15"><pose>15 10 0.001 0 0 0</pose><geometry><box><size>0.02 20 0.002</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <visual name="grid_v_16"><pose>16 10 0.001 0 0 0</pose><geometry><box><size>0.02 20 0.002</size></box></geometry>
