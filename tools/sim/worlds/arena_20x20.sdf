    <!-- ===== 树林：93 根圆柱，直径 0.3m、高 2.0m，带碰撞 =====
         排布：8 个密集簇（簇内间距 0.6~1.5m）+ 零散树（最近邻 2~3m），疏密不均 -->
    <model name="trees">
      <static>true</static>
        <link name="tree_0"><pose>2.29 4.94 1.0 0 0 0</pose>
          <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>2.0</length></cylinder></geometry></collision>
