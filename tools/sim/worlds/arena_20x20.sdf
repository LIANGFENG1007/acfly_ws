<?xml version="1.0"?>
<!-- PX4 x500_lidar_3d 纯探索效率场地，20 x 20 m，世界 X/Y=[0,20]。
     起飞 (1,1,0)，yaw=0；Point-LIO 起飞原点下边界 X/Y=[-1,19]。
     外墙仍在 -1/21，保留原有障碍位置和碰撞体；树视觉高度对齐碰撞高度 2m。
     PX4_GZ_WORLD=arena_20x20 PX4_GZ_MODEL_POSE="1,1,0,0,0,0"
     地面网格为纯视觉，无碰撞体。 -->
<sdf version="1.9">
  <world name="arena_20x20">

    <!-- ========== PX4 必需配置：球面坐标系 ========== -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ========== 环境设置 ========== -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>0.0 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <!-- ========== PX4 必需插件 ========== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 地板：白色，20m(x) x 20m(y)，x,y ∈ [0,20] -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <pose>10 10 0 0 0 0</pose>
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>10 10 6 0 0 0</pose>
      <direction>-0.4 0.4 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ===== 边缘墙，高2m，半透明(视觉+碰撞)，离地板边缘留 1.0m 空隙，不贴地图 ===== -->

    <model name="wall_south">
      <pose>10 -1.0 1.0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>22 0.05 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>22 0.05 2.0</size></box></geometry>
          <material><ambient>0.4 0.55 0.75 0.15</ambient><diffuse>0.4 0.55 0.75 0.15</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <pose>10 21.0 1.0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>22 0.05 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>22 0.05 2.0</size></box></geometry>
          <material><ambient>0.4 0.55 0.75 0.15</ambient><diffuse>0.4 0.55 0.75 0.15</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <pose>-1.0 10 1.0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 22 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 22 2.0</size></box></geometry>
          <material><ambient>0.4 0.55 0.75 0.15</ambient><diffuse>0.4 0.55 0.75 0.15</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <pose>21.0 10 1.0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 22 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 22 2.0</size></box></geometry>
          <material><ambient>0.4 0.55 0.75 0.15</ambient><diffuse>0.4 0.55 0.75 0.15</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ===== 1m x 1m 地面网格线（纯视觉，无碰撞体） ===== -->
    <model name="grid_lines">
      <static>true</static>
      <link name="link">
        <!-- 南北向线 x=0..20，贯穿全场 -->
        <visual name="grid_v_0"><pose>0 10 0.001 0 0 0</pose><geometry><box><size>0.02 20 0.002</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <visual name="grid_v_1"><pose>1 10 0.001 0 0 0</pose><geometry><box><size>0.02 20 0.002</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <visual name="grid_v_2"><pose>2 10 0.001 0 0 0</pose><geometry><box><size>0.02 20 0.002</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <visual name="grid_v_3"><pose>3 10 0.001 0 0 0</pose><geometry><box><size>0.02 20 0.002</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
