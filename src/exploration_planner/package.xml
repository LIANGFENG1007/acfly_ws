<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>exploration_planner</name>
  <version>0.0.0</version>
  <description>全局自主探索算法：双层栅格 + 牛耕覆盖路径 + 贝塞尔平滑 + 轨迹跟踪 PID，输出机体系速度给 fly_mission</description>
  <maintainer email="yk@todo.todo">yk</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>point_lio</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>odom_to_visionpose</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>fly_mission</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
