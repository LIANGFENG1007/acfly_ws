%% ACFly 参数配置分层
%% 编辑本文件后，可用 tools/render_diagrams.sh 重新生成 config-layers.svg。
flowchart LR
    index["config/\n根目录编辑索引\n相对符号链接"]
    yaml["包内分类 YAML\nmission / orbit / flight_control / watchdogs\nmapping / coverage / motion / return / runtime\ninput / region / detection / display"]
    defaults["节点声明\nacfly_config::Defaults\n类型、范围、几何关系校验"]
    override["运行时覆盖\n--params-file\n-p name:=value\n同名同类型"]
    restart["重启节点\n运行中的节点不动态读取文件"]

    index -->|"定位并编辑"| yaml
    yaml -->|"启动时加载"| defaults
    defaults -->|"ROS 参数覆盖"| override
    override -->|"生效"| restart

    classDef index fill:#e8eef7,stroke:#6f8fb4,color:#172334,stroke-width:2px;
    classDef yaml fill:#fff3dc,stroke:#c68a2c,color:#172334,stroke-width:2px;
    classDef node fill:#e8f4ee,stroke:#4f9b73,color:#172334,stroke-width:2px;
    classDef override fill:#f0e8fa,stroke:#8965b5,color:#172334,stroke-width:2px;
    class index index;
    class yaml yaml;
    class defaults,restart node;
    class override override;
